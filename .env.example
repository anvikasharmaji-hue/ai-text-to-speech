# ==============================================================
# ElevenLabs Text-to-Speech API Configuration
# ==============================================================
# 1. Copy this file and rename the copy to: .env
# 2. Get your free API key at: https://elevenlabs.io
#    (Sign up -> Click your profile in bottom-left -> API Keys -> Create Key)
# 3. Paste your key below without quotes:
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here

# Port for the local server (default: 3000)
PORT=3000
